{
  "name": "marketplace-tool",
  "version": "0.1.0",
  "description": "Personal marketplace listing manager for Facebook Marketplace and Kijiji Canada",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Excellonline/market-place.git"
  },
  "bugs": {
    "url": "https://github.com/Excellonline/market-place/issues"
  },
  "homepage": "https://github.com/Excellonline/market-place#readme",
  "keywords": [
    "electron",
    "facebook-marketplace",
    "kijiji",
    "marketplace",
    "playwright",
    "react"
  ],
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pack:win": "electron-vite build && npm run rebuild:electron && electron-builder --win --dir",
    "dist:win": "electron-vite build && npm run rebuild:electron && electron-builder --win",
    "pretest": "npm rebuild better-sqlite3 --update-binary",
    "test": "vitest run",
    "posttest": "npm run rebuild:electron",
    "test:watch": "vitest",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3 && electron-builder install-app-deps",
    "install:chromium": "playwright install chromium",
    "setup": "npm install && npm run rebuild:electron && npm run install:chromium"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-table": "^8.20.0",
    "archiver": "^7.0.1",
    "archiver-utils": "^5.0.2",
    "better-sqlite3": "^12.10.0",
    "lucide-react": "^0.469.0",
    "nanoid": "^5.0.9",
    "node-cron": "^3.0.3",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.49.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "sharp": "^0.33.5",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/archiver": "^6.0.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
